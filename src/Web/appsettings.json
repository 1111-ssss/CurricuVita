{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "BaseUrl": "http://localhost:5153"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=your_database;Username=your_username;Password=your_password"
  },
  "Cloudinary": {
    "CloudName": "your_cloud_name",
    "ApiKey": "your_api_key",
    "ApiSecret": "your_api_secret"
  },
  "Authentication": {
    "Google": {
      "ClientId": "your_client_id",
      "ClientSecret": "your_client_secret"
    },
    "GitHub": {
      "ClientId": "your_client_id",
      "ClientSecret": "your_client_secret"
    }
  },
  "Identity": {
    "Cookie": {
      "LoginPath": "/account/login",
      "LogoutPath": "/account/logout",
      "AccessDeniedPath": "/account/access-denied",
      "ExpireTimeSpan": "14.00:00:00",
      "SlidingExpiration": true
    }
  },
  "EmailSender": {
    "SmtpServer": "your_smtp_server",
    "Port": 587,
    "From": "your_from_email",
    "Password": "your_password",
    "TokenLifetime": "10.00:00:00"
  }
}
