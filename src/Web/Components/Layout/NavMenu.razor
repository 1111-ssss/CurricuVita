@inject IStringLocalizer<SharedResource> T

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@T["App_Name"]</a>
    </div>
</div>

<input type="checkbox" title="@T["Nav_Toggle"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @T["Nav_Home"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="account/login">
                <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> @T["Nav_SignIn"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="account/register">
                <span class="bi bi-person-plus-fill-nav-menu" aria-hidden="true"></span> @T["Nav_SignUp"]
            </NavLink>
        </div>
    </nav>
</div>
