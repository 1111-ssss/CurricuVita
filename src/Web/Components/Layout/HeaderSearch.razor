@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T

<form class="d-flex flex-grow-1 navbar-search my-2 my-lg-0" role="search" @onsubmit="Go" @onsubmit:preventDefault="true">
    <div class="input-group">
        <span class="input-group-text bg-body border-end-0"><i class="bi bi-search"></i></span>
        <input class="form-control border-start-0"
            @bind="q"
            @bind:event="oninput"
            type="search"
            placeholder="@T["Search_Placeholder"]"
            aria-label="@T["Search_Label"]" />
        <button class="btn btn-outline-primary" type="submit">@T["Search_Button"]</button>
    </div>
</form>

<style>
    .navbar-search {
        max-width: 320px;
        min-width: 0;
        width: 100%;
        flex-wrap: nowrap;
    }
    .navbar-search .input-group {
        flex-wrap: nowrap;
    }
    @@media (min-width: 1200px) {
        .navbar-search {
            max-width: 380px;
        }
    }
    @@media (max-width: 991.98px) {
        .navbar-search {
            max-width: none;
        }
    }
</style>

@code {
    private string q = string.Empty;

    private void Go()
    {
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(q)
            ? "positions"
            : $"positions?q={Uri.EscapeDataString(q.Trim())}");
    }
}
