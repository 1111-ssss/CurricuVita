@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> T
@inject NavigationManager Navigation

<div class="page">
    <nav class="navbar navbar-expand-lg border-bottom sticky-top bg-body-tertiary">
        <div class="container-fluid main-header-container">
            <a class="navbar-brand fw-bold text-nowrap flex-shrink-0" href="">
                <i class="bi bi-file-earmark-person-fill text-primary"></i> @T["App_Name"]
            </a>
            <button class="navbar-toggler flex-shrink-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="@T["Nav_Toggle"]">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <div class="main-navbar-body">
                    <div class="main-search">
                        <HeaderSearch />
                    </div>
                    <div class="main-nav">
                        <NavMenu />
                    </div>
                    <div class="main-prefs">
                        <CultureSelector />
                        <ThemeSelector />
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <footer class="border-top mt-auto py-3 bg-body-tertiary">
        <div class="container-fluid d-flex flex-wrap gap-2 align-items-center">
            <span class="text-body-secondary small me-auto">@T["App_Name"]</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="OpenSupport">
                <i class="bi bi-question-circle me-1"></i>@T["Support_CreateTicket"]
            </button>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @T["ErrorUi_Unhandled"]
    <a href="." class="reload">@T["ErrorUi_Reload"]</a>
    <span class="dismiss" title="@T["ErrorUi_Dismiss"]">x</span>
</div>

@code {
    private void OpenSupport()
    {
        Navigation.NavigateTo("/support/new?returnUrl=" + Uri.EscapeDataString(Navigation.Uri));
    }
}
