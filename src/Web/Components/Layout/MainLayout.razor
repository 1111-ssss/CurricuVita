@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> T

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="ms-auto d-flex align-items-center gap-2">
                <CultureSelector />
                <ThemeSelector />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @T["ErrorUi_Unhandled"]
    <a href="." class="reload">@T["ErrorUi_Reload"]</a>
    <span class="dismiss" title="@T["ErrorUi_Dismiss"]">🗙</span>
</div>
