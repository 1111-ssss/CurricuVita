@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["Error_Title"]</PageTitle>

<h1 class="text-danger">@T["Error_Heading"]</h1>
<h2 class="text-danger">@T["Error_Subheading"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@T["Error_RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@T["Error_DevHeading"]</h3>
<p>@T["Error_DevSwap"]</p>
<p>@T["Error_DevWarning"]</p>
<p>@T["Error_DevHow"]</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
