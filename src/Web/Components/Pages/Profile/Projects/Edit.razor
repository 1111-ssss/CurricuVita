@page "/profile/projects/{Id:int}"

@using MediatR
@using Application.Features.Projects.GetProject
@using Application.Features.Projects.UpdateProject
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using System.Security.Claims

@attribute [Authorize]

@inject ISender Sender
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T
@inject ILogger<Edit> Logger

<PageTitle>@T["Profile_ProjectEditTitle"]</PageTitle>

<h1>@T["Profile_ProjectEditTitle"]</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
        @if (isConflict)
        {
            <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="ReloadAsync">@T["Profile_Reload"]</button>
        }
    </div>
}

@if (isLoading)
{
    <p><em>@T["Profile_Loading"]</em></p>
}
else
{
    <div class="col-12 col-lg-8 col-xl-6">
        <EditForm Model="model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label">@T["Profile_FieldTitle"]</label>
                <InputText @bind-Value="model.Title" class="form-control" maxlength="200" />
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label">@T["Profile_FieldStart"]</label>
                    <InputDate @bind-Value="model.StartDate" class="form-control" />
                </div>
                <div class="col-6">
                    <label class="form-label">@T["Profile_FieldEnd"]</label>
                    <InputDate @bind-Value="model.EndDate" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">@T["Profile_FieldDescription"]</label>
                <InputTextArea @bind-Value="model.DescriptionMarkdown" class="form-control" rows="6" maxlength="20000" />
            </div>

            <div class="mb-3">
                <label class="form-label">@T["Profile_FieldTags"]</label>
                <Web.Components.Shared.TagPicker @bind-SelectedTags="selectedTags" />
                <div class="form-text">@T["Profile_TagsHint"]</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@(isSaving || isConflict)">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    @T["Profile_Save"]
                </button>
                <a class="btn btn-outline-secondary" href="profile">@T["Profile_Cancel"]</a>
            </div>
        </EditForm>
    </div>
}

<div class="mt-3">
    <a href="profile">@T["Profile_Back"]</a>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private int userId;
    private ProjectFormModel model = new();
    private List<string> selectedTags = new();
    private int version;
    private bool isLoading = true;
    private bool isSaving;
    private bool isConflict;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var idValue = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!int.TryParse(idValue, out userId))
        {
            Navigation.NavigateTo("/account/login?returnUrl=" + Uri.EscapeDataString("/profile"), forceLoad: true);
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        errorMessage = null;
        isConflict = false;

        try
        {
            var result = await Sender.Send(new GetProjectQuery(Id, userId));
            if (result.IsSuccess)
            {
                var dto = result.Value;
                version = dto.Version;
                selectedTags = dto.Tags.ToList();
                model = new ProjectFormModel
                {
                    Title = dto.Title,
                    StartDate = dto.StartDate,
                    EndDate = dto.EndDate,
                    DescriptionMarkdown = dto.DescriptionMarkdown
                };
            }
            else
            {
                var localized = LocalizedError.Message(T, result.Error?.Code, T["Profile_Unexpected"]);
                errorMessage = CombineWithServerError(localized, result.Error?.Message, result.Details);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load project {ProjectId} failed for user {UserId}", Id, userId);
            errorMessage = T["Profile_Unexpected"];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;
        isConflict = false;

        try
        {
            var result = await Sender.Send(new UpdateProjectCommand(
                Id,
                userId,
                model.Title.Trim(),
                model.StartDate,
                model.EndDate,
                model.DescriptionMarkdown ?? string.Empty,
                selectedTags,
                version));

            if (result.IsSuccess)
            {
                Navigation.NavigateTo("profile");
            }
            else
            {
                isConflict = result.Error?.Code == "ConcurrencyConflict";
                var localized = LocalizedError.Message(T, result.Error?.Code, T["Profile_Unexpected"]);
                errorMessage = CombineWithServerError(localized, result.Error?.Message, result.Details);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Update project {ProjectId} failed for user {UserId}", Id, userId);
            errorMessage = T["Profile_Unexpected"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string CombineWithServerError(string localized, string? serverMessage, Dictionary<string, string>? details)
    {
        if (!string.IsNullOrWhiteSpace(serverMessage)
            && !string.Equals(serverMessage.Trim(), localized.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            localized += $" {serverMessage.Trim()}";
        }

        if (details is { Count: > 0 })
        {
            localized += $" {string.Join("; ", details.Values)}";
        }

        return localized;
    }

    public sealed class ProjectFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;

        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(20000)]
        public string DescriptionMarkdown { get; set; } = string.Empty;
    }
}
