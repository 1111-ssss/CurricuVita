            DefinitionId = dto.AttributeDefinitionId,
            Name = dto.Name,
            Category = dto.Category,
            Description = dto.Description,
            DataType = dto.DataType,
            Options = dto.Options,
            Version = dto.Version ?? 1,
            StringValue = dto.StringValue,
            TextValue = dto.TextValue,
            ImageValue = dto.ImageValue,
            NumericValue = dto.NumericValue,
            DateValue = dto.DateValue,
            PeriodStartValue = dto.PeriodStartValue,
            PeriodEndValue = dto.PeriodEndValue,
            BooleanValue = dto.BooleanValue ?? false,
            DropdownValue = dto.DropdownValue
        };

        public static ValueRow NewEmpty(AttributeDto definition) => new()
        {
            DefinitionId = definition.Id,
            Name = definition.Name,
            Category = definition.Category,
            Description = definition.Description,
            DataType = definition.DataType,
            Options = definition.Options,
            Version = 1,
