@page "/"

@using MediatR
@using Microsoft.AspNetCore.Components.Authorization
@using Domain.Contracts.HomeContracts
@using Application.Features.Home.GetDashboard

@inject ISender Sender
@inject IStringLocalizer<SharedResource> T
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

<PageTitle>@T["Home_Title"]</PageTitle>

<div class="py-3">
    <h1 class="display-5"><i class="bi bi-file-earmark-person-fill text-primary me-2"></i>@T["Home_Heading"]</h1>
    <p class="lead text-body-secondary">@T["Home_Lead"]</p>
    <div class="row g-2 align-items-end mb-4">
        <div class="col-12 col-md-6">
            <label class="form-label" for="home-search">@T["Home_SearchLabel"]</label>
            <input id="home-search" class="form-control" @bind="homeSearch"
                @bind:event="oninput" @onkeyup="OnHomeSearchKeyUp"
                placeholder="@T["Home_SearchPlaceholder"]" />
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button class="btn btn-outline-primary flex-fill" @onclick="GoToPositions"><i class="bi bi-search me-1"></i>@T["Home_SearchButton"]</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (isLoading)
{
    <p><em>@T["Home_Loading"]</em></p>
}
else if (dashboard is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body text-center">
                    <div class="fs-6 opacity-75"><i class="bi bi-lightning-charge-fill"></i></div>
                    <div class="h3 card-title mb-0">@dashboard.Stats.CvsLast24h</div>
                    <p class="card-text small mb-0">@T["Home_Stat24h"]</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body text-center">
                    <div class="fs-6 opacity-75"><i class="bi bi-briefcase-fill"></i></div>
                    <div class="h3 card-title mb-0">@dashboard.Stats.TotalPositions</div>
                    <p class="card-text small mb-0">@T["Home_StatPositions"]</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body text-center">
                    <div class="fs-6 opacity-75"><i class="bi bi-people-fill"></i></div>
                    <div class="h3 card-title mb-0">@dashboard.Stats.TotalCandidates</div>
                    <p class="card-text small mb-0">@T["Home_StatCandidates"]</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body text-center">
                    <div class="fs-6 opacity-75"><i class="bi bi-person-badge-fill"></i></div>
                    <div class="h3 card-title mb-0">@dashboard.Stats.TotalRecruiters</div>
                    <p class="card-text small mb-0">@T["Home_StatRecruiters"]</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center bg-transparent">
                    <h2 class="h5 mb-0"><i class="bi bi-clock-history me-1"></i>@T["Home_LatestHeading"]</h2>
                    <a href="positions" class="btn btn-sm btn-outline-primary">@T["Home_AllPositions"]</a>
                </div>
                @if (dashboard.LatestPositions.Count == 0)
                {
                    <div class="card-body"><p class="text-body-secondary mb-0"><em>@T["Home_Empty"]</em></p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">@T["Home_ColTitle"]</th>
                                    <th scope="col">@T["Pos_FieldCompany"]</th>
                                    <th scope="col">@T["Pos_FieldLevel"]</th>
                                    <th scope="col" class="text-end">@T["Home_ColCvs"]</th>
                                    <th scope="col" class="text-end">@T["Home_ColUpdated"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in dashboard.LatestPositions)
                                {
                                    <tr>
                                        <td><a href="@($"positions/{p.Id}")" class="text-decoration-none fw-bold">@p.Title</a></td>
                                        <td>@(p.Company ?? "—")</td>
                                        <td><span class="badge @LevelBadge(p.Level)">@(p.Level ?? "—")</span></td>
                                        <td class="text-end"><span class="badge bg-primary rounded-pill">@p.CvCount</span></td>
                                        <td class="text-end text-muted small">@p.UpdatedAt.ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="card mb-4">
                <div class="card-header bg-transparent">
                    <h2 class="h5 mb-0"><i class="bi bi-trophy-fill me-1"></i>@T["Home_TopHeading"]</h2>
                </div>
                @if (dashboard.TopPositions.Count == 0)
                {
                    <div class="card-body"><p class="text-body-secondary mb-0"><em>@T["Home_Empty"]</em></p></div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in dashboard.TopPositions)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="@($"positions/{p.Id}")" class="text-decoration-none">@p.Title</a>
                                <span class="badge bg-primary rounded-pill">@p.CvCount @T["Home_ColCvs"]</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-transparent">
                    <h2 class="h5 mb-0"><i class="bi bi-tags-fill me-1"></i>@T["Home_TagsHeading"]</h2>
                </div>
                <div class="card-body text-center">
                    @if (dashboard.TagCloud.Count == 0)
                    {
                        <p class="text-body-secondary mb-0"><em>@T["Home_NoTags"]</em></p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            @foreach (var tag in dashboard.TagCloud)
                            {
                                <a class="badge text-decoration-none @TagColor(tag.Name) @TagSize(tag.Count)"
                                href="@TagHref(tag.Name)"
                                title="@tag.Count">@tag.Name</a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between text-muted small">
                        <span><i class="bi bi-file-earmark-text me-1"></i>@T["Home_StatCvs"]: <strong>@dashboard.Stats.SubmittedCvs</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private HomeDashboardDto? dashboard;
    private bool isLoading = true;
    private string? errorMessage;
    private string homeSearch = string.Empty;
    private bool tagLinksToCvs;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            tagLinksToCvs = state.User.IsInRole(Domain.Constants.UserRoles.Recruiter)
                || state.User.IsInRole(Domain.Constants.UserRoles.Administrator);
        }
        catch
        {
        }

        try
        {
            var result = await Sender.Send(new GetHomeDashboardQuery());
            if (result.IsSuccess)
            {
                dashboard = result.Value;
            }
            else
            {
                errorMessage = result.Error?.Message ?? "Failed to load dashboard.";
            }
        }
        catch
        {
            errorMessage = "Failed to load dashboard.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToPositions()
    {
        var url = "positions";
        if (!string.IsNullOrWhiteSpace(homeSearch))
        {
            url += $"?q={Uri.EscapeDataString(homeSearch.Trim())}";
        }
        Navigation.NavigateTo(url);
    }

    private string TagHref(string tagName)
    {
        var tag = Uri.EscapeDataString(tagName);
        return tagLinksToCvs ? $"positions?tag={tag}&view=cvs" : $"positions?tag={tag}&view=positions";
    }

    private void OnHomeSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            GoToPositions();
        }
    }

    private static string LevelBadge(string? level) => level switch
    {
        "Junior" => "text-bg-success",
        "Middle" => "text-bg-warning",
        "Senior" => "text-bg-danger",
        "C-level" => "text-bg-dark",
        _ => "text-bg-secondary"
    };

    private static string TagSize(int count) =>
        count >= 10 ? "tag-cloud-xl" : count >= 5 ? "tag-cloud-lg" : count >= 2 ? "tag-cloud-md" : "tag-cloud-sm";

    private static string TagColor(string name)
    {
        var palette = new[] { "text-bg-primary", "text-bg-info", "text-bg-success", "text-bg-warning", "text-bg-danger", "text-bg-secondary", "text-bg-dark" };
        return palette[Math.Abs(name.GetHashCode()) % palette.Length];
    }
}
