<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_curricuvita_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">curricuvita.position</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_curricuvita_position_tree" model="ir.ui.view">
        <field name="name">curricuvita.position.tree</field>
        <field name="model">curricuvita.position</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="company"/>
                <field name="level"/>
                <field name="published_cv_count"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_curricuvita_position_form" model="ir.ui.view">
        <field name="name">curricuvita.position.form</field>
        <field name="model">curricuvita.position</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="company" readonly="1"/>
                        <field name="level" readonly="1"/>
                        <field name="published_cv_count" readonly="1"/>
                        <field name="last_sync" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Attributes">
                            <field name="attribute_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="data_type"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                        <page string="Numeric">
                            <field name="numeric_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="count"/>
                                    <field name="average"/>
                                    <field name="min"/>
                                    <field name="max"/>
                                </list>
                            </field>
                        </page>
                        <page string="Text">
                            <field name="text_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="total"/>
                                </list>
                                <form create="0" edit="0" delete="0">
                                    <sheet>
                                        <group>
                                            <field name="name" readonly="1"/>
                                            <field name="total" readonly="1"/>
                                        </group>
                                        <field name="value_ids" readonly="1">
                                            <list create="0" edit="0" delete="0">
                                                <field name="name"/>
                                                <field name="count"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
